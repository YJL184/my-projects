# 换行符统一:仓库内统一存 LF,避免 CRLF/LF 噪音
* text=auto eol=lf

# Windows 脚本保持 CRLF,避免 cmd / PowerShell 解析问题
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件:禁止换行转换与文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.rar   binary
*.exe   binary
*.dll   binary
*.woff  binary
*.woff2 binary

# 锁文件不做逐行 diff,减少评审噪音
package-lock.json -diff
pnpm-lock.yaml    -diff
yarn.lock         -diff